dev/shots/
node_modules/
.DS_Store

# art masters: ~2MB each, only used as input to `npm run images`.
# they stay on this disk; the site publishes the avif/webp derivatives.
panels/**/*.png
assets/**/*.png
# ...except the site icons, which browsers and search results fetch directly
!assets/icon-*.png
# art generation working files (prompts, reroll logs, QC reports): never published
panels/**/_*
assets/_*

# AOCI agent host integration (machine-bound; do not commit)
.mcp.json
.mcp.json.backup.*
.codex/config.toml
.codex/config.toml.backup.*

# AOCI wire (aoci-wire.sh) — machine-bound, do not commit
.cursor/mcp.json
.cursor/mcp.json.backup.*
.zcode/config.json
.zcode/config.json.backup.*
opencode.json
opencode.json.backup.*
AGENTS.md.backup.*
